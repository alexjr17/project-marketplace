# ============================================================
# Variables de entorno para el despliegue del backend en Render
# Rellena los valores vacíos y pega este contenido en
# Render -> tu servicio -> Environment.
# ============================================================

APP_NAME=Vexa
APP_ENV=production
APP_DEBUG=false
# Copia el APP_KEY de tu archivo local api/.env (línea APP_KEY=base64:...)
APP_KEY=
APP_URL=https://project-marketplace.onrender.com

# --- Base de datos (PostgreSQL gestionado por Render) ---
# Opción A (recomendada): pega la "Internal Database URL" de tu Postgres de Render.
#   La encuentras en: Render -> tu base de datos Postgres -> Connections.
#   Si la usas, NO hace falta rellenar DB_HOST/PORT/etc. (Laravel la parsea sola).
DB_CONNECTION=pgsql
DB_URL=

# Opción B: en vez de DB_URL, rellena los campos sueltos (mismos datos de Render).
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# Render exige SSL; 'prefer' funciona en la red interna y también con la URL externa.
DB_SSLMODE=prefer

# --- Sesiones ---
# OBLIGATORIO 'file': no hay tabla `sessions`, así que 'database' rompería
# con 500 las rutas web (raíz / y la doc /api/doc).
SESSION_DRIVER=file

# --- Documentación de la API (Scramble en /api/doc) ---
# Token para ver la doc en producción: /api/doc?token=EL_TOKEN
SCRAMBLE_DOCS_TOKEN=

# --- CORS: dominio del frontend en Vercel ---
CORS_ALLOWED_ORIGINS=https://project-marketplace-five.vercel.app

# --- Logs a stderr para verlos en los Logs de Render ---
LOG_CHANNEL=stderr
