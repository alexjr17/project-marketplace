# ============================================================
# Variables de entorno para el despliegue del backend en Render
# Rellena los valores vacíos y pega este contenido en
# Render -> tu servicio -> Environment.
# ============================================================

APP_NAME=Vexa
APP_ENV=production
APP_DEBUG=false
# Copia el APP_KEY de tu archivo local api/.env (línea APP_KEY=base64:...)
APP_KEY=
APP_URL=https://project-marketplace-9dau.onrender.com

# --- Base de datos (TiDB Cloud) ---
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=4000
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# TiDB exige SSL; el CA del sistema sirve.
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# --- CORS: dominio del frontend en Vercel ---
CORS_ALLOWED_ORIGINS=https://project-marketplace-five.vercel.app

# --- Logs a stderr para verlos en los Logs de Render ---
LOG_CHANNEL=stderr
